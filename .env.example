APP_NAME="イントラデリバー"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8020

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# php artisan serve(composer run dev)の待ち受けポート。作業木ごとに別の値にする(docs の 設計/コード構成/検査/一括検査の段.md 6.5)
SERVER_PORT=8020

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5445
# 作業木ごとに別の値にする(docs の 設計/コード構成/検査/一括検査の段.md 6.5)
DB_DATABASE=intra_deliver_portfolio
DB_USERNAME=intra_deliver
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_MAX_FILE_BYTES=99614720
UPLOAD_MAX_REQUEST_BYTES=99614720
UPLOAD_MAX_TOTAL_BYTES=10737418240
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AI の費用の上限(米ドル。空は上限なし。区分と値の正本 = docs の 設計/AI/実行と費用.md 5 節)。既定の区分は AI_BUDGET_*(未設定なら 日 5・月 50・累計 200)
AI_TRANSCRIPTION_BUDGET_DAILY_USD=2
AI_TRANSCRIPTION_BUDGET_MONTHLY_USD=20
AI_TRANSCRIPTION_BUDGET_TOTAL_USD=

# 会議の削除予定日の既定の期間(ISO 8601。正本 = docs の 設計/業務ツール/会議/通知と削除予定日.md の 7.1)
MEETING_PURGE_AFTER=P6M

VITE_APP_NAME="${APP_NAME}"

DEMO_ENABLED=false

# 公開デモの毎日の初期化(全データを初期データへ戻す。公開する環境だけがオンにする = docs の 設計/公開の配備/毎日の初期化.md 5 節)
DAILY_RESET_ENABLED=false
