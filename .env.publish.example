# 公開用の設定ファイルの雛形(docs の 設計/公開の配備/構成/設定.md 3.4、DBと秘密.md 4.4)。値は書かない(秘密と、置き場・版ごとに変わる値は空)。
# 節ごとに、公開用の設定ディレクトリ(リポジトリの外)の同じ名前のファイルへ写し、権限を 600 にする(配備と戻し方.md 6.2 の 1)。
# 秘密は作るコマンドの出力をファイルへ直接書き、画面に出さない(DBと秘密.md 4.3)。開発用の .env.example(composer setup)とは別。

# ==== compose.env(compose の補間だけに使う。秘密を持たない。どのコンテナにも渡らない) ====
# 今の版 = web の git の短い SHA(配備と戻し方.md 6.1)
IMAGE_TAG=
# 公開用の設定ディレクトリの絶対パス
PUBLISH_CONFIG_DIR=

# ==== app.env(app・queue・scheduler) ====
APP_ENV=production
APP_DEBUG=false
# 初回に 1 回だけ、一回きりのコンテナで php artisan key:generate --show を流して書く
APP_KEY=
# https://intra-deliver.<アカウントのサブドメイン>.workers.dev
APP_URL=
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
# db.env の APP_DB_NAME・APP_DB_USER・APP_DB_PASSWORD と同じ値
DB_DATABASE=intra_deliver_portfolio
DB_USERNAME=intra_deliver_app
DB_PASSWORD=
DB_SSLMODE=disable
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_SECURE_COOKIE=true
# 利用者の切替(公開する環境だけがオンにする)
DEMO_ENABLED=true
INERTIA_DEVTOOLS_ENABLED=false
# AI の費用の上限(米ドル。空は上限なし。値の正本 = docs の 設計/AI/実行と費用.md の 5 節の公開デモの値)
AI_BUDGET_DAILY_USD=5
AI_BUDGET_MONTHLY_USD=50
AI_BUDGET_TOTAL_USD=200
AI_TRANSCRIPTION_BUDGET_DAILY_USD=2
AI_TRANSCRIPTION_BUDGET_MONTHLY_USD=20
AI_TRANSCRIPTION_BUDGET_TOTAL_USD=

# ==== db.env(db) ====
# スーパーユーザー(初期化とロールの管理だけに使う)。POSTGRES_DB は書かない(イメージの既定のまま)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# 初期化のスクリプト(docker/initdb-publish/)が読む。アプリ用ロールとその所有の DB
APP_DB_NAME=intra_deliver_portfolio
APP_DB_USER=intra_deliver_app
APP_DB_PASSWORD=

# ==== tunnel.env(tunnel) ====
# Cloudflare の画面で Tunnel を作ると出る。画面からファイルへ直接写す
TUNNEL_TOKEN=

# ==== ai.env(queue だけ) ====
# AI の接続先の鍵(config/ai.php が読む)。app.env に置かない(外から届く app が破られても鍵が漏れないため = docs の 設計/公開の配備/構成/設定.md の 3.4 節)。
# 接続先の画面で作り、画面からファイルへ直接写す(チャット・文書に貼らない)
ANTHROPIC_API_KEY=
# Gemini は有料の枠(課金を有効にした Google Cloud のプロジェクト)の鍵だけを置く。無料の枠は送ったデータを学習に使う
# (docs の 設計/AI/データと失敗と検査.md の 6 節)
GEMINI_API_KEY=
