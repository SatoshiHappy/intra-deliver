{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "scripts/ci/record vp-check -- vp check",
        "check:fix": "vp check --fix",
        "types:check": "scripts/ci/record tsc -- tsc --noEmit",
        "deps:check": "scripts/ci/record depcruise -- depcruise resources/js --config .dependency-cruiser.cjs",
        "unused:check": "scripts/ci/record knip -- knip",
        "test:unit": "scripts/ci/record vp-test -- vp test",
        "test:e2e": "scripts/ci/record playwright -- playwright test"
    },
    "dependencies": {
        "@dagrejs/dagre": "3.1.1",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans-jp": "^5.3.0",
        "@inertiajs/react": "^3.9.1",
        "@inertiajs/vite": "^3.9.1",
        "@xyflow/react": "12.12.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^1.54.0",
        "radix-ui": "^1.7.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "10.1.0",
        "remark-breaks": "4.0.0",
        "remark-gfm": "4.0.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5"
    },
    "devDependencies": {
        "@ast-grep/cli": "^0.50.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "dependency-cruiser": "^18.6.0",
        "knip": "^6.41.0",
        "typescript": "^5.2.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "wrangler": "4.149.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "$vite",
        "vitest": "5.0.5"
    }
}
