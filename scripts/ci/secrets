#!/usr/bin/env bash
# K 秘匿情報(#11)。gitleaks で (1) 全 ref の履歴と (2) 作業木を検査する。
# (1) は gitleaks git の既定(git log --all)のまま HEAD に絞らない: 並行セッションの枝も push すると公開先に出るため。
# --all は stash(作業木のあいだで共有)も含むので、ほかのセッションの stash の中身で落ちることがある。
# 設定は (1) = .gitleaks.toml、(2) = .gitleaks-dir.toml(.gitleaks.toml を [extend] で取り込み、git 管理外の .env 系の除外を足す)。
# .gitleaks-dir.toml の [extend] の path は gitleaks のプロセスの作業ディレクトリ基点で解決されるので、このアプリのルートで実行する。
# 検出が 1 件でもあれば非 0 で終わる(免除は .gitleaks-baseline.json だけで表す。台帳⑧ #11 に登録する)。
# 流用元 = chatpinet_2 の scripts/ci/secrets(走査の対象をこのリポジトリのルートに書き直し、バイナリの取得を scripts/ci/gitleaks に分けた)。
set -euo pipefail

cd "$(dirname "$0")/../.."

if [ "$#" -ne 0 ]; then
    echo "scripts/ci/secrets は引数を受けない" >&2
    exit 2
fi

readonly GITLEAKS_BIN="build/bin/gitleaks"
# #11 の対象はリポジトリルート。このアプリのルートがリポジトリのルート(作業ディレクトリからの相対パス)
readonly REPO_ROOT="."

# バイナリの取得(版と SHA-256 の固定)は scripts/ci/gitleaks に置く(秘匿情報の自己証明も同じものを使う)
scripts/ci/gitleaks

failed=0

echo "==> gitleaks git(全 ref の履歴)"
if ! scripts/ci/record gitleaks-git -- "${GITLEAKS_BIN}" git "${REPO_ROOT}" \
    --config .gitleaks.toml \
    --baseline-path .gitleaks-baseline.json \
    --redact \
    --no-banner \
    --exit-code 1 \
    --report-format json \
    --report-path build/gitleaks-git.json; then
    failed=1
fi

echo "==> gitleaks dir(作業木)"
if ! scripts/ci/record gitleaks-dir -- "${GITLEAKS_BIN}" dir "${REPO_ROOT}" \
    --config .gitleaks-dir.toml \
    --baseline-path .gitleaks-baseline.json \
    --redact \
    --no-banner \
    --exit-code 1 \
    --report-format json \
    --report-path build/gitleaks-dir.json; then
    failed=1
fi

exit "${failed}"
