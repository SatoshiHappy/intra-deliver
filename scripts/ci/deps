#!/usr/bin/env bash
# D 依存の妥当性と脆弱性監査・ライセンスの検査(#7)。
# 定義と lock の整合(composer / npm 双方)と、本番の依存のライセンスが許可リストに収まること(例外は台帳⑧ #7 の期限つきの行)を確かめる。
# 依存の監査(advisory・放棄されたパッケージ)は走らせて注意に出し、門では止めない(docs の 設計/コード構成/検査/一括検査の段.md 6.5)。
set -euo pipefail

cd "$(dirname "$0")/../.."

if [ "$#" -ne 0 ]; then
    echo "scripts/ci/deps は引数を受けない" >&2
    exit 2
fi

echo "==> composer validate(composer.json と composer.lock の整合)"
scripts/ci/record composer-validate -- composer validate --strict --no-check-publish

echo "==> npm ci --dry-run(package.json と package-lock.json の整合。作業木は変えない)"
scripts/ci/record npm-ci-dry-run -- npm ci --ignore-scripts --dry-run

echo "==> 依存の監査(composer audit・npm audit。見つかったものは注意に出し、止めない。監査が走らなければ失敗)"
scripts/ci/record audit -- php scripts/ci/audit.php

if [ ! -d node_modules ]; then
    echo "node_modules が無い。npm ci を先に実行する" >&2
    exit 1
fi

echo "==> ライセンス(composer・npm の本番の依存が許可リストに収まる。台帳⑧ #7 の期限付き除外を除く)"
scripts/ci/record licenses -- php scripts/ci/licenses.php
